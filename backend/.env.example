# Server-side only. Never prefix these with VITE_.
HF_ACCESS_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
PORT=3001
# Frontend origin(s) allowed by CORS. Comma-separate multiple origins.
# Defaults to the Vite dev server (http://localhost:5173) outside production.
CLIENT_ORIGIN=http://localhost:5173
# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=
# Secret used to sign login tokens. Required (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Auth cookie SameSite policy: lax (default, same-site frontend+API), strict, or none (frontend and API on different sites; forces Secure).
AUTH_COOKIE_SAMESITE=lax
