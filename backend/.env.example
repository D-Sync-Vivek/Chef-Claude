# Copy to backend/.env and fill in real values. NEVER commit backend/.env or put real keys in this file.
# Every secret stays on the server: never use a VITE_ prefix and never send these to the frontend.

# --- Server -------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=
JWT_SECRET=                      # random string, at least 32 characters
# AUTH_COOKIE_SAMESITE=lax
# TRUST_PROXY=0

# --- AI providers -------------------------------------------------------------------------
# Priority order, highest first. Names: gemini, groq, huggingface (alias: hf), openai.
# A provider with no API key is skipped; remove a name to disable that provider.
AI_PROVIDER_ORDER=gemini,groq,huggingface,openai

# Per provider call, and for one whole recipe request across all providers (seconds).
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_TOTAL_TIMEOUT_SECONDS=100

# 1. Google Gemini (primary). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Groq (first fallback). Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. Hugging Face (second fallback). Token: https://huggingface.co/settings/tokens
#    The token needs permission to call Inference Providers. Paid usage may need pre-paid credits.
#    The model may carry a provider suffix, e.g. Qwen/Qwen2.5-7B-Instruct:featherless-ai
HF_ACCESS_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# 4. OpenAI (final fallback). Key: https://platform.openai.com/api-keys (billing required)
#    Check the model id at https://platform.openai.com/docs/models before relying on the default.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional, reasoning models only (for example low). Leave empty for other models.
OPENAI_REASONING_EFFORT=

# --- Rate limits (optional) ---------------------------------------------------------------
# AI_RATE_LIMIT_MAX=20
# AI_RATE_LIMIT_WINDOW_MINUTES=15
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MINUTES=15
